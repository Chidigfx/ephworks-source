# Copy to .env.local. Leave empty to run the local-only demo.
# Supabase dashboard → Project Settings → API. Use the anon/publishable key only, never the service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Cloudflare Turnstile *site* key (public). Set it together with Turnstile in Supabase → Authentication → Attack Protection.
VITE_TURNSTILE_SITE_KEY=
